+    /**
+     * On a cold process start the JS side needs a few seconds before it publishes a
+     * library. Wait for it instead of answering with the fallback playlist list.
+     */
+    private suspend fun awaitMediaLibrary(timeoutMs: Long = 15_000): MediaLibrary? {
+        val deadline = System.currentTimeMillis() + timeoutMs
+        while (System.currentTimeMillis() < deadline) {
+            mediaLibraryManager.getMediaLibrary()?.let { return it }
+            kotlinx.coroutines.delay(250)
+        }
+        return mediaLibraryManager.getMediaLibrary()
+    }
