+package com.margelo.nitro.nitroplayer.media
+
+import android.os.Bundle
+import androidx.media3.session.CommandButton
+import androidx.media3.session.SessionCommand
+import androidx.media3.session.SessionCommands
+
+/**
+ * App-defined buttons shown next to the transport controls (Android Auto's playback screen,
+ * the media notification, watches). Set them with [set]; a press calls [onPressed] on the
+ * main thread with the button's action.
+ */
+object SessionCustomButtons {
+    /** [icon] is one of [ICONS]' keys. */
+    data class Button(
+        val action: String,
+        val displayName: String,
+        val icon: String,
+    )
+
+    private val ICONS =
+        mapOf(
+            "heart" to CommandButton.ICON_HEART_UNFILLED,
+            "heart_filled" to CommandButton.ICON_HEART_FILLED,
+            "star" to CommandButton.ICON_STAR_UNFILLED,
+            "star_filled" to CommandButton.ICON_STAR_FILLED,
+            "plus" to CommandButton.ICON_PLUS,
+        )
+
+    @Volatile
+    var buttons: List<Button> = emptyList()
+        private set
+
+    @Volatile
+    var onPressed: ((action: String) -> Unit)? = null
+
+    fun set(buttons: List<Button>) {
+        this.buttons = buttons.filter { it.icon in ICONS }
+        NitroPlayerPlaybackService.applyCustomButtons()
+    }
+
+    internal fun commandButtons(): List<CommandButton> =
+        buttons.map {
+            CommandButton
+                .Builder(ICONS.getValue(it.icon))
+                .setDisplayName(it.displayName)
+                .setSessionCommand(SessionCommand(it.action, Bundle.EMPTY))
+                // Overflow only: a button allowed in the back/forward slot jumps there whenever
+                // previous/next is unavailable, and those slots stop being reserved.
+                .setSlots(CommandButton.SLOT_OVERFLOW)
+                .build()
+        }
+
+    /** Default session commands plus every custom button's command. */
+    internal fun sessionCommands(defaults: SessionCommands): SessionCommands =
+        defaults
+            .buildUpon()
+            .apply { buttons.forEach { add(SessionCommand(it.action, Bundle.EMPTY)) } }
+            .build()
+
+    internal fun handles(action: String) = buttons.any { it.action == action }
+}
