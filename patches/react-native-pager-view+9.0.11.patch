+  /// The vertical pager is a horizontal scroll view rotated 90 degrees, so UIKit's
+  /// sheet presentation never sees it as a vertical scroll view resting at its top
+  /// edge and the pan swallows the swipe-to-dismiss. On the first page, refuse a
+  /// downward drag (towards the nonexistent previous page) while presented modally
+  /// so the sheet's dismiss gesture can take it.
+  private func yieldsToSheetDismissGesture(in scrollView: UIScrollView) -> Bool {
+    guard orientation == .vertical, currentPage == 0, !scrollView.bounces, isPresentedModally(scrollView) else {
+      return false
+    }
+
+    // In the rotated scroll view's own coordinates, a downward drag on screen is +x.
+    let pan = scrollView.panGestureRecognizer
+    var dx = pan.velocity(in: scrollView).x
+    if dx == 0 {
+      dx = pan.translation(in: scrollView).x
+    }
+
+    return dx > 0
+  }
+
+  private func isPresentedModally(_ scrollView: UIScrollView) -> Bool {
+    var responder: UIResponder? = scrollView.next
+    while let current = responder {
+      if let controller = current as? UIViewController, controller.presentingViewController != nil {
+        return true
+      }
+      responder = current.next
+    }
+    return false
+  }
