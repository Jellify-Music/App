{
	"extends": "@react-native/typescript-config",
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["**/node_modules", "**/Pods", "jest"],
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"]
		},
		"jsx": "react-native",
		"types": ["jest", "node"],
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true
	}
}
